# ~/.secrets - Variables sensibles (NO commitear a git)
# Copia este archivo a ~/.secrets y edita con tus valores

# Terraform - Linode
export TF_VAR_linode_token="TU_LINODE_TOKEN"
export TF_VAR_domain="ecavero.space"

# Terraform - Cloudflare
export TF_VAR_cloudflare_token="TU_CLOUDFLARE_TOKEN"
export TF_VAR_cloudflare_zone_id="TU_CLOUDFLARE_ZONE_ID"

# WiFi
export WIFI_PASSWORD="TU_WIFI_PASSWORD"
